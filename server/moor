#!/usr/bin/env python3
"""Moor server helper. Runs on the machine you SSH into; needs only Python 3.

    moor pair [--host H] [--port 22] [--cmd CMD] [--name NAME] [--minutes 10]
        Print a one-time QR code and link. Scan it in the Moor app to set up the
        connection and register the phone's SSH key in one step.
    moor new NAME [--cmd CMD] [--cwd DIR] / ls / attach NAME / kill NAME / rename NAME NEW
        Terminal sessions that keep running after you disconnect. A small daemon
        (started on demand) owns them and replays recent output when you attach.
    moor hooks install|uninstall|status
        Add (or remove) Claude Code hooks that send "needs your input" and
        "finished" events to the phone.
    moor notify claude|bell [SESSION]
        Record an event (called by the hooks above and by Moor's tmux bell hook).
    moor watch [--since EPOCH_MS]
        Print events newer than EPOCH_MS, then follow new ones (used by the app).
    moor claim ID     (internal: run by the one-time pairing key)
    moor clean        (remove expired one-time pairing keys)

How pairing works: `pair` creates a throwaway SSH key and adds its public half to
~/.ssh/authorized_keys with expiry-time (sshd refuses it after N minutes),
restrict (no terminal, no forwarding) and command= (it can only run `moor claim`).
The QR code carries the host, the host's public key and the throwaway key's seed.
The phone logs in once with it and hands over its own public key; `claim` adds
that key and deletes the throwaway one.
"""
import argparse
import base64
import datetime
import fcntl
import getpass
import json
import os
import pathlib
import re
import secrets
import socket
import subprocess
import sys
import tempfile
import time
import unicodedata
import urllib.parse

HOME = pathlib.Path.home()
# The two variables below exist for tests that run a throwaway sshd.
AK = pathlib.Path(os.environ.get("MOOR_AUTHORIZED_KEYS", HOME / ".ssh" / "authorized_keys"))
HOST_KEY = pathlib.Path(os.environ.get("MOOR_HOST_KEY", "/etc/ssh/ssh_host_ed25519_key.pub"))
EVENTS = pathlib.Path(os.environ.get("MOOR_EVENTS", HOME / ".local" / "state" / "moor" / "events.log"))
CLAUDE_SETTINGS = HOME / ".claude" / "settings.json"
MARK = "moor-pair:"
PUB_RE = re.compile(r"ssh-ed25519 [A-Za-z0-9+/]{68} ?[A-Za-z0-9@._+-]{0,100}")
EXP_RE = re.compile(r'expiry-time="(\d{12})"')


# ---------------------------------------------------------------- pairing

def rewrite_keys(change):
    """Read-modify-write authorized_keys under a lock, in place (keeps symlinks and mode)."""
    AK.parent.mkdir(mode=0o700, exist_ok=True)
    AK.touch(mode=0o600, exist_ok=True)
    with open(AK, "r+", encoding="utf-8") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        lines = f.read().splitlines()
        new = change(lines)
        if new != lines:
            f.seek(0)
            f.write("".join(line + "\n" for line in new))
            f.truncate()
    return new


def drop_expired(lines):
    now = datetime.datetime.now().strftime("%Y%m%d%H%M")
    out = []
    for line in lines:
        m = EXP_RE.search(line)
        if MARK in line and m and m.group(1) <= now:
            continue
        out.append(line)
    return out


def seed_of(private_key_file):
    """The 32-byte seed inside an unencrypted OpenSSH ed25519 private key."""
    body = "".join(l for l in private_key_file.read_text().splitlines() if not l.startswith("-----"))
    blob = base64.b64decode(body)
    i = blob.index(b"\0") + 1

    def take():
        nonlocal i
        n = int.from_bytes(blob[i:i + 4], "big")
        v = blob[i + 4:i + 4 + n]
        i += 4 + n
        return v

    take(), take(), take()          # cipher, kdf, kdf options
    i += 4                          # number of keys
    take()                          # public key
    priv = take()
    j = 8                           # two check ints
    for _ in range(2):              # key type, public key
        n = int.from_bytes(priv[j:j + 4], "big")
        j += 4 + n
    return priv[j + 4:j + 4 + 32]


def default_host():
    out = subprocess.run(["hostname", "-I"], capture_output=True, text=True).stdout.split()
    v4 = [a for a in out if re.fullmatch(r"\d+\.\d+\.\d+\.\d+", a)]
    return (v4 or out or ["localhost"])[0]


def print_qr(text):
    try:
        import segno
    except ImportError:
        print("(Install segno to show a QR code here: pip3 install --user segno)\n")
        return
    rows = [[bool(c) for c in r] for r in segno.make(text, error="m", micro=False).matrix]
    quiet = 2
    width = len(rows[0]) + quiet * 2
    blank = [False] * width
    rows = [blank] * quiet + [[False] * quiet + r + [False] * quiet for r in rows] + [blank] * quiet
    if len(rows) % 2:
        rows.append(blank)
    # Fixed black on white, so dark terminal themes don't invert the code.
    for top, bottom in zip(rows[0::2], rows[1::2]):
        line = []
        for t, b in zip(top, bottom):
            fg = "\033[38;2;0;0;0m" if t else "\033[38;2;255;255;255m"
            bg = "\033[48;2;0;0;0m" if b else "\033[48;2;255;255;255m"
            line.append(fg + bg + "▀")
        print("".join(line) + "\033[0m")


def pair(args):
    host_key = HOST_KEY.read_text().split()[1]
    pid = secrets.token_hex(4)
    expires = datetime.datetime.now() + datetime.timedelta(minutes=args.minutes)
    with tempfile.TemporaryDirectory() as d:
        key = pathlib.Path(d) / "k"
        subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", MARK + pid, "-f", str(key)], check=True)
        seed = seed_of(key)
        pub = (pathlib.Path(d) / "k.pub").read_text().split()[1]
    script = pathlib.Path(__file__).resolve()
    env = f"MOOR_AUTHORIZED_KEYS={AK} " if "MOOR_AUTHORIZED_KEYS" in os.environ else ""
    entry = (f'expiry-time="{expires:%Y%m%d%H%M}",restrict,command="{env}{sys.executable} {script} claim {pid}" '
             f"ssh-ed25519 {pub} {MARK}{pid}")
    rewrite_keys(lambda lines: drop_expired(lines) + [entry])

    q = {
        "v": "1", "h": args.host, "p": str(args.port), "u": getpass.getuser(), "c": args.cmd,
        "n": args.name or socket.gethostname().split(".")[0],
        "hk": host_key, "k": base64.urlsafe_b64encode(seed).decode().rstrip("="),
        "id": pid, "exp": str(int(expires.timestamp())),
    }
    url = "moor://pair?" + urllib.parse.urlencode(q, quote_via=urllib.parse.quote)
    print_qr(url)
    print("\nIn Moor: Settings → Scan QR, or Add machine on the session list. Or copy the link below and use Paste link.")
    print(f"Valid until {expires:%H:%M}, single use.\n")
    print(url)


def claim(pid):
    if not re.fullmatch(r"[0-9a-f]{8}", pid):
        sys.exit("bad id")
    line = sys.stdin.readline(4096).strip()
    if not PUB_RE.fullmatch(line):
        sys.exit("bad key")
    blob = line.split()[1]
    tag = MARK + pid

    def change(lines):
        if not any(l.endswith(tag) for l in lines):
            sys.exit("expired")
        out = [l for l in lines if not l.endswith(tag)]
        if not any(blob in l for l in out):
            out.append(line)
        return drop_expired(out)

    rewrite_keys(change)
    print("ok")


# ---------------------------------------------------------------- events

def where():
    """(session, source) of the program that raised the event."""
    name = session_name_from_env()
    if name:
        return name, "moor"
    tmux = os.environ.get("TMUX", "")
    if tmux and os.path.basename(tmux.split(",")[0]) == "moor":
        r = subprocess.run(["tmux", "display-message", "-p", "#S"], capture_output=True, text=True, timeout=3)
        return r.stdout.strip(), "moor"
    tab = os.environ.get("HERDR_TAB_ID")
    if tab:
        try:
            r = subprocess.run(["herdr", "tab", "get", tab], capture_output=True, text=True, timeout=3)
            label = json.loads(r.stdout)["result"]["tab"].get("label") or ""
            return label, "herdr"
        except Exception:
            return "", "herdr"
    return "", ""


def last_assistant_text(transcript):
    """First few hundred characters of Claude's last reply, from the session transcript."""
    try:
        p = pathlib.Path(transcript)
        with open(p, "rb") as f:
            f.seek(max(0, p.stat().st_size - 512 * 1024))
            lines = f.read().decode("utf-8", "replace").splitlines()
        for raw in reversed(lines):
            try:
                e = json.loads(raw)
            except ValueError:
                continue
            if e.get("type") != "assistant":
                continue
            parts = [c.get("text", "") for c in e.get("message", {}).get("content", []) if isinstance(c, dict) and c.get("type") == "text"]
            text = " ".join(" ".join(parts).split())
            if text:
                return text[:300]
    except Exception:
        pass
    return ""


def one_line(s, n=300):
    return " ".join(str(s).replace("\t", " ").split())[:n]


def append_event(kind, session, source, cwd, body):
    EVENTS.parent.mkdir(parents=True, exist_ok=True)
    for home in (str(HOME), os.path.realpath(HOME)):
        if cwd == home or cwd.startswith(home + "/"):
            cwd = "~" + cwd[len(home):]
            break
    line = "\t".join([str(int(time.time() * 1000)), kind, one_line(session, 80), source, one_line(cwd, 120), one_line(body)])
    with open(EVENTS, "a+", encoding="utf-8") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(line + "\n")
        if f.tell() > 256 * 1024:  # keep the log small
            f.seek(0)
            keep = f.read().splitlines()[-500:]
            f.seek(0)
            f.truncate()
            f.write("".join(l + "\n" for l in keep))


def notify(kind, session_arg):
    try:
        data = {}
        if kind == "claude" and not sys.stdin.isatty():
            try:
                data = json.loads(sys.stdin.read() or "{}")
            except ValueError:
                data = {}
        session, source = (session_arg, "moor") if session_arg else where()
        cwd = data.get("cwd") or os.getcwd()
        if kind == "claude":
            ev = data.get("hook_event_name", "")
            if ev == "Notification":
                append_event("attention", session, source, cwd, data.get("message", ""))
            elif ev == "Stop":
                append_event("done", session, source, cwd, last_assistant_text(data.get("transcript_path", "")))
        elif kind == "bell":
            append_event("bell", session, source, cwd, "")
    except Exception:
        pass  # never break the caller (a Claude hook or tmux)


def watch(since):
    EVENTS.parent.mkdir(parents=True, exist_ok=True)
    EVENTS.touch(exist_ok=True)
    out = sys.stdout
    f = open(EVENTS, encoding="utf-8")
    for line in f:
        try:
            if int(line.split("\t", 1)[0]) > since:
                out.write(line)
        except ValueError:
            pass
    out.write("ready\n")
    out.flush()
    while True:
        line = f.readline()
        if line:
            out.write(line)
            out.flush()
            continue
        time.sleep(0.5)
        try:
            if EVENTS.stat().st_size < f.tell():  # trimmed: start over from the top
                f.close()
                f = open(EVENTS, encoding="utf-8")
        except FileNotFoundError:
            EVENTS.touch()


# ---------------------------------------------------------------- Claude Code hooks

def hooks(action):
    cmd = f"{pathlib.Path(__file__).resolve()} notify claude"
    cfg = json.loads(CLAUDE_SETTINGS.read_text()) if CLAUDE_SETTINGS.exists() else {}
    hk = cfg.get("hooks", {})
    installed = all(any("notify claude" in h.get("command", "") and "moor" in h.get("command", "")
                        for g in hk.get(ev, []) for h in g.get("hooks", [])) for ev in ("Notification", "Stop"))
    if action == "status":
        print("installed" if installed else "not installed")
        return
    for ev in ("Notification", "Stop"):
        groups = hk.setdefault(ev, [])
        for g in groups:
            g["hooks"] = [h for h in g.get("hooks", [])
                          if not ("notify claude" in h.get("command", "") and "moor" in h.get("command", ""))]
        groups[:] = [g for g in groups if g.get("hooks")]
        if action == "install":
            groups.append({"hooks": [{"type": "command", "command": cmd, "timeout": 10}]})
        if not groups:
            del hk[ev]
    if hk:
        cfg["hooks"] = hk
    else:
        cfg.pop("hooks", None)
    CLAUDE_SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    if CLAUDE_SETTINGS.exists():
        backup = CLAUDE_SETTINGS.with_name("settings.json.moor-backup")
        backup.write_text(CLAUDE_SETTINGS.read_text())
    tmp = CLAUDE_SETTINGS.with_name("settings.json.moor-tmp")
    tmp.write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n")
    os.replace(tmp, CLAUDE_SETTINGS)
    print("installed" if action == "install" else "uninstalled")


# ---------------------------------------------------------------- sessions
#
# A small daemon keeps the terminal sessions: it owns each session's pty, keeps the last output so a
# phone that attaches later gets it replayed (and can scroll it locally), and remembers terminal modes
# (alternate screen, mouse reporting, ...) so they are restored after the replay. The app talks to it
# through the commands below over SSH; `moor attach` relays a session through the SSH channel's pty.

STATE = pathlib.Path(os.environ.get("MOOR_STATE", HOME / ".local" / "state" / "moor"))
SOCK = STATE / "daemon.sock"
if len(str(SOCK)) > 100:  # AF_UNIX path limit; keep a private short path instead
    SOCK = pathlib.Path(tempfile.gettempdir()) / f"moor-{os.getuid()}" / "daemon.sock"
PROTO = 1
LOG_CAP = 256 * 1024
SHELL_NAMES = {"zsh", "bash", "sh", "fish", "dash", "ksh", "tcsh", "nu", "login"}
TRACKED_MODES = (1, 7, 25, 1000, 1002, 1003, 1004, 1005, 1006, 1015, 2004)
ALT_MODES = {47, 1047, 1049}
MODE_RE = re.compile(rb"\x1b\[\?([0-9;]+)([hl])")
OSC_RE = re.compile(rb"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)")
# The app treats terminal replies produced while replaying as stale and drops them until it sees this.
REPLAY_DONE = b"\x1b]7777;moor-replayed\x07"


def _complete_escape(buf, i):
    """True if the escape sequence starting at buf[i] is complete."""
    if i + 1 >= len(buf):
        return False
    kind = buf[i + 1]
    if kind == 0x5B:  # CSI
        return any(0x40 <= b <= 0x7E for b in buf[i + 2:])
    if kind in (0x5D, 0x50, 0x5E, 0x5F):  # OSC, DCS, PM, APC
        rest = buf[i + 2:]
        return b"\x07" in rest or b"\x1b\\" in rest
    return True


class Screen:
    """Just enough of a terminal to show a session's last lines in the app's list."""
    TOKENS = re.compile(r"\x1b\[([0-9;?<>=!]*)[ -/]*([@-~])|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)?|"
                        r"\x1b[P^_][^\x1b]*(?:\x1b\\)?|\x1b.?|[\x00-\x1f\x7f]|[^\x00-\x1f\x1b\x7f]+", re.S)

    def __init__(self, cols, rows):
        self.c, self.r = max(cols, 20), max(rows, 4)
        self.rows = [[" "] * self.c for _ in range(self.r)]
        self.x = self.y = 0
        self.saved = (0, 0)

    def _nl(self):
        if self.y < self.r - 1:
            self.y += 1
        else:
            self.rows.pop(0)
            self.rows.append([" "] * self.c)

    def _put(self, ch):
        w = 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
        if self.x + w > self.c:
            self.x = 0
            self._nl()
        self.rows[self.y][self.x] = ch
        if w == 2 and self.x + 1 < self.c:
            self.rows[self.y][self.x + 1] = ""
        self.x += w

    def feed(self, text):
        for m in self.TOKENS.finditer(text):
            t = m.group(0)
            if m.group(2):
                ps = [int(p) if p.isdigit() else 0 for p in m.group(1).lstrip("?<>=!").split(";")]
                n = ps[0] or 1
                f = m.group(2)
                if f in "Hf":
                    self.y = min(max((ps[0] or 1) - 1, 0), self.r - 1)
                    self.x = min(max(((ps[1] if len(ps) > 1 else 0) or 1) - 1, 0), self.c - 1)
                elif f == "A":
                    self.y = max(self.y - n, 0)
                elif f == "B":
                    self.y = min(self.y + n, self.r - 1)
                elif f == "C":
                    self.x = min(self.x + n, self.c - 1)
                elif f == "D":
                    self.x = max(self.x - n, 0)
                elif f == "G":
                    self.x = min(n - 1, self.c - 1)
                elif f == "d":
                    self.y = min(n - 1, self.r - 1)
                elif f == "J":
                    if ps[0] == 0:
                        self.rows[self.y][self.x:] = [" "] * (self.c - self.x)
                        for r in range(self.y + 1, self.r):
                            self.rows[r] = [" "] * self.c
                    elif ps[0] == 1:
                        for r in range(self.y):
                            self.rows[r] = [" "] * self.c
                    else:
                        self.rows = [[" "] * self.c for _ in range(self.r)]
                elif f == "K":
                    row = self.rows[self.y]
                    if ps[0] == 0:
                        row[self.x:] = [" "] * (self.c - self.x)
                    elif ps[0] == 1:
                        row[:self.x + 1] = [" "] * (self.x + 1)
                    else:
                        self.rows[self.y] = [" "] * self.c
                elif f == "X":
                    row = self.rows[self.y]
                    for i in range(self.x, min(self.x + n, self.c)):
                        row[i] = " "
                elif f in "hl" and m.group(1).startswith("?") and ALT_MODES & set(ps):
                    self.rows = [[" "] * self.c for _ in range(self.r)]
                    self.x = self.y = 0
            elif t == "\r":
                self.x = 0
            elif t == "\n":
                self._nl()
            elif t == "\b":
                self.x = max(self.x - 1, 0)
            elif t == "\t":
                self.x = min((self.x // 8 + 1) * 8, self.c - 1)
            elif t == "\x1b7":
                self.saved = (self.x, self.y)
            elif t == "\x1b8":
                self.x, self.y = self.saved
            elif t[0] not in "\x1b\x00\x07\x7f" and ord(t[0]) >= 0x20:
                for ch in t:
                    self._put(ch)

    def last_lines(self, n=2):
        lines = ["".join(r).rstrip() for r in self.rows]
        return [l for l in lines if l.strip()][-n:]


class Sess:
    def __init__(self, sid, name, master, pid, cwd, cols, rows):
        self.id, self.name, self.master, self.pid, self.cwd = sid, name, master, pid, cwd
        self.cols, self.rows = cols, rows
        self.created = self.activity = int(time.time())
        self.main, self.alt, self.alt_on = bytearray(), bytearray(), False
        self.modes = {}
        self.hold = b""
        self.inbuf = bytearray()
        self.clients = []
        self.last_bell = 0

    def record(self, data):
        self.activity = int(time.time())
        buf = self.hold + data
        cut = len(buf)
        esc = buf.rfind(b"\x1b", max(0, len(buf) - 512))
        if esc != -1 and not _complete_escape(buf, esc):
            cut = esc
        self.hold, buf = buf[cut:], buf[:cut]
        if len(self.hold) > 4096:
            buf, self.hold = buf + self.hold, b""
        pos = 0
        for m in MODE_RE.finditer(buf):
            nums = {int(p) for p in m.group(1).split(b";") if p.isdigit()}
            on = m.group(2) == b"h"
            if nums & ALT_MODES:
                (self.alt if self.alt_on else self.main).extend(buf[pos:m.start()])
                self.alt_on = on
                self.alt = bytearray()
                pos = m.end()
            for n in nums - ALT_MODES:
                self.modes[n] = on
        (self.alt if self.alt_on else self.main).extend(buf[pos:])
        for log in (self.main, self.alt):
            if len(log) > LOG_CAP:
                del log[:len(log) - LOG_CAP]
        if b"\x07" in OSC_RE.sub(b"", buf) and time.time() - self.last_bell > 5:
            self.last_bell = time.time()
            try:
                append_event("bell", self.name, "moor", self.current_cwd(), "")
            except Exception:
                pass

    def replay(self):
        main = bytes(self.main)
        if len(main) >= LOG_CAP:  # trimmed: start at a line boundary
            main = main[main.find(b"\n") + 1:]
        out = bytearray(main)
        if self.alt_on:
            out += b"\x1b[?1049h\x1b[H\x1b[2J" + self.alt
        for n in TRACKED_MODES:
            if n in self.modes:
                out += b"\x1b[?%d%s" % (n, b"h" if self.modes[n] else b"l")
        return bytes(out) + REPLAY_DONE

    def fg_pid(self):
        try:
            return os.tcgetpgrp(self.master)
        except OSError:
            return self.pid

    def command(self):
        pid = self.fg_pid()
        try:
            return pathlib.Path(f"/proc/{pid}/comm").read_text().strip()
        except OSError:
            try:
                r = subprocess.run(["ps", "-o", "comm=", "-p", str(pid)], capture_output=True, text=True, timeout=2)
                return os.path.basename(r.stdout.strip()).lstrip("-")
            except Exception:
                return ""

    def current_cwd(self):
        try:
            return os.readlink(f"/proc/{self.fg_pid()}/cwd")
        except OSError:
            return self.cwd

    def preview(self):
        s = Screen(self.cols, self.rows)
        s.feed(bytes((self.alt if self.alt_on else self.main)[-24 * 1024:]).decode("utf-8", "replace"))
        return s.last_lines()


class Daemon:
    def __init__(self):
        import selectors
        self.sel = selectors.DefaultSelector()
        self.sessions = {}
        self.next_id = 1
        self.timers = []
        self.dead = set()  # pids to reap
        self.EVENT_READ, self.EVENT_WRITE = selectors.EVENT_READ, selectors.EVENT_WRITE

    # -- plumbing

    def watch(self, fd, data, write=False):
        ev = self.EVENT_READ | (self.EVENT_WRITE if write else 0)
        try:
            self.sel.modify(fd, ev, data)
        except KeyError:
            self.sel.register(fd, ev, data)

    def unwatch(self, fd):
        try:
            self.sel.unregister(fd)
        except (KeyError, ValueError):
            pass

    def send(self, conn, data):
        conn["out"] += data
        if len(conn["out"]) > 16 * 1024 * 1024:  # a client that stopped reading
            self.drop(conn)
            return
        self.watch(conn["sock"], ("conn", conn), write=True)

    def drop(self, conn):
        self.unwatch(conn["sock"])
        try:
            conn["sock"].close()
        except OSError:
            pass
        s = conn.get("sess")
        if s and conn in s.clients:
            s.clients.remove(conn)

    def winsize(self, s, cols, rows):
        import struct
        import termios
        fcntl.ioctl(s.master, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))

    # -- sessions

    def spawn(self, name, cmd, cwd, cols, rows):
        import pty
        import pwd
        import struct
        import termios
        cwd = os.path.expanduser(cwd or "~")
        if not os.path.isdir(cwd):
            raise ValueError(f"no such directory: {cwd}")
        sid = self.next_id
        self.next_id += 1
        shell = os.environ.get("SHELL") or pwd.getpwuid(os.getuid()).pw_shell or "/bin/sh"
        pid, master = pty.fork()
        if pid == 0:
            try:
                import signal
                for sig in (signal.SIGPIPE, signal.SIGHUP, signal.SIGCHLD, signal.SIGINT):
                    signal.signal(sig, signal.SIG_DFL)
                fcntl.ioctl(0, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
                os.chdir(cwd)
                env = dict(os.environ)
                for k in ("TMUX", "TMUX_PANE", "MOOR_STATE_DAEMON"):
                    env.pop(k, None)
                env.update(TERM="xterm-256color", COLORTERM="truecolor", MOOR_SESSION_ID=str(sid), SHELL=shell)
                env.setdefault("LANG", "C.UTF-8")
                os.execvpe(shell, [shell, "-l"], env)
            finally:
                os._exit(127)
        os.set_blocking(master, False)
        s = Sess(sid, name, master, pid, cwd, cols, rows)
        self.sessions[name] = s
        self.watch(master, ("pty", s))
        if cmd:
            self.type_into(s, cmd.encode() + b"\r")
        return s

    def type_into(self, s, data):
        s.inbuf += data
        self.watch(s.master, ("pty", s), write=True)

    def end(self, s):
        self.unwatch(s.master)
        try:
            os.close(s.master)
        except OSError:
            pass
        self.dead.add(s.pid)
        if self.sessions.get(s.name) is s:
            del self.sessions[s.name]
        for c in list(s.clients):
            c["closing"] = True
            if not c["out"]:
                self.drop(c)

    def kill(self, s):
        import signal
        for sig in (signal.SIGHUP, signal.SIGTERM):
            try:
                os.killpg(s.pid, sig)
            except OSError:
                pass
        self.timers.append((time.time() + 2, lambda: self._force_kill(s)))
        self.end(s)

    def _force_kill(self, s):
        import signal
        try:
            os.killpg(s.pid, signal.SIGKILL)
        except OSError:
            pass

    def redraw(self, s):
        """Full-screen programs repaint only on SIGWINCH: shrink by a row, then restore."""
        if s.rows < 2:
            return
        self.winsize(s, s.cols, s.rows - 1)
        self.timers.append((time.time() + 0.15, lambda: s.name in self.sessions and self.winsize(s, s.cols, s.rows)))

    # -- requests

    def handle(self, conn, req):
        op = req.get("op")
        reply = lambda d: self.send(conn, (json.dumps(d) + "\n").encode())
        if op == "hello":
            reply({"ok": True, "v": PROTO, "sessions": len(self.sessions)})
        elif op == "list":
            items = []
            for s in self.sessions.values():
                items.append({"name": s.name, "created": s.created, "activity": s.activity,
                              "attached": len(s.clients), "command": s.command(), "cwd": s.current_cwd(),
                              "preview": s.preview()})
            reply({"ok": True, "now": int(time.time()), "items": items})
        elif op == "new":
            name = req.get("name", "")
            if not name or name in self.sessions:
                reply({"ok": False, "error": "a session with this name exists" if name else "name required"})
                return
            try:
                self.spawn(name, req.get("cmd", ""), req.get("cwd", ""), int(req.get("cols", 80)), int(req.get("rows", 24)))
                reply({"ok": True})
            except Exception as e:
                reply({"ok": False, "error": str(e)})
        elif op == "kill":
            s = self.sessions.get(req.get("name"))
            if s:
                self.kill(s)
            reply({"ok": bool(s), "error": "" if s else "no such session"})
        elif op == "rename":
            s, to = self.sessions.get(req.get("name")), req.get("to", "")
            if not s or not to or to in self.sessions:
                reply({"ok": False, "error": "no such session" if not s else "a session with this name exists"})
                return
            del self.sessions[s.name]
            s.name = to
            self.sessions[to] = s
            reply({"ok": True})
        elif op == "name":
            match = [s.name for s in self.sessions.values() if str(s.id) == str(req.get("id"))]
            reply({"ok": bool(match), "name": match[0] if match else ""})
        elif op == "quit":
            reply({"ok": True})
            if not self.sessions or req.get("force"):
                self.timers.append((time.time() + 0.2, lambda: sys.exit(0)))
        elif op == "attach":
            s = self.sessions.get(req.get("name"))
            if not s:
                reply({"ok": False, "error": "no such session"})
                return
            reply({"ok": True})
            conn["sess"] = s
            s.clients.append(conn)
            self.send(conn, s.replay())
            cols, rows = int(req.get("cols", s.cols)), int(req.get("rows", s.rows))
            if (cols, rows) != (s.cols, s.rows):
                s.cols, s.rows = cols, rows
                self.winsize(s, cols, rows)
            elif s.alt_on or s.command() not in SHELL_NAMES:
                self.redraw(s)
        else:
            reply({"ok": False, "error": "unknown request"})

    def on_conn_input(self, conn, data):
        conn["in"] += data
        buf = conn["in"]
        if "sess" not in conn:
            nl = buf.find(b"\n")
            if nl < 0:
                if len(buf) > 65536:
                    self.drop(conn)
                return
            line, rest = bytes(buf[:nl]), bytes(buf[nl + 1:])
            conn["in"] = bytearray(rest)
            try:
                self.handle(conn, json.loads(line))
            except ValueError:
                self.drop(conn)
                return
            if "sess" not in conn:
                conn["closing"] = True  # one request per connection
                return
            buf = conn["in"]
        s = conn["sess"]
        while len(buf) >= 5:
            kind, n = buf[0:1], int.from_bytes(buf[1:5], "big")
            if len(buf) < 5 + n:
                break
            payload = bytes(buf[5:5 + n])
            del buf[:5 + n]
            if s.name not in self.sessions:
                continue
            if kind == b"D":
                self.type_into(s, payload)
            elif kind == b"R":
                try:
                    size = json.loads(payload)
                    s.cols, s.rows = max(int(size["cols"]), 2), max(int(size["rows"]), 2)
                    self.winsize(s, s.cols, s.rows)
                except (ValueError, KeyError, OSError):
                    pass

    # -- loop

    def run(self):
        import signal
        import socket as sk
        STATE.mkdir(parents=True, exist_ok=True)
        lock = open(STATE / "daemon.lock", "w")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return  # another daemon is running
        signal.signal(signal.SIGHUP, signal.SIG_IGN)
        signal.signal(signal.SIGPIPE, signal.SIG_IGN)
        SOCK.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        try:
            SOCK.unlink()
        except FileNotFoundError:
            pass
        old = os.umask(0o077)
        srv = sk.socket(sk.AF_UNIX, sk.SOCK_STREAM)
        srv.bind(str(SOCK))
        os.umask(old)
        srv.listen(16)
        srv.setblocking(False)
        self.sel.register(srv, self.EVENT_READ, ("listen", None))
        while True:
            now = time.time()
            due = [t for t in self.timers if t[0] <= now]
            self.timers = [t for t in self.timers if t[0] > now]
            for _, fn in due:
                try:
                    fn()
                except OSError:
                    pass
            timeout = min([t[0] for t in self.timers], default=now + 5) - now
            for key, ev in self.sel.select(max(timeout, 0)):
                kind, obj = key.data
                if kind == "listen":
                    try:
                        c, _ = srv.accept()
                        c.setblocking(False)
                        conn = {"sock": c, "in": bytearray(), "out": bytearray()}
                        self.watch(c, ("conn", conn))
                    except OSError:
                        pass
                elif kind == "pty":
                    self.on_pty(obj, ev)
                else:
                    self.on_conn(obj, ev)
            for pid in list(self.dead):
                try:
                    if os.waitpid(pid, os.WNOHANG)[0]:
                        self.dead.discard(pid)
                except ChildProcessError:
                    self.dead.discard(pid)
            for s in list(self.sessions.values()):
                # The shell exited but something still holds the terminal open: end the session shortly
                try:
                    if not getattr(s, "exited", False) and os.waitpid(s.pid, os.WNOHANG)[0]:
                        s.exited = True
                        self.timers.append((time.time() + 0.5, lambda s=s: s.name in self.sessions and self.end(s)))
                except ChildProcessError:
                    pass

    def on_pty(self, s, ev):
        if ev & self.EVENT_READ:
            try:
                data = os.read(s.master, 65536)
            except BlockingIOError:
                data = None
            except OSError:
                data = b""
            if data == b"":
                self.end(s)
                return
            if data:
                s.record(data)
                for c in list(s.clients):
                    self.send(c, data)
        if ev & self.EVENT_WRITE and s.inbuf:
            try:
                n = os.write(s.master, s.inbuf)
                del s.inbuf[:n]
            except BlockingIOError:
                pass
            except OSError:
                s.inbuf.clear()
            if not s.inbuf and s.name in self.sessions:
                self.watch(s.master, ("pty", s))

    def on_conn(self, conn, ev):
        sock = conn["sock"]
        if ev & self.EVENT_READ:
            try:
                data = sock.recv(65536)
            except BlockingIOError:
                data = None
            except OSError:
                data = b""
            if data == b"":
                self.drop(conn)
                return
            if data:
                self.on_conn_input(conn, data)
        if ev & self.EVENT_WRITE and conn["out"]:
            try:
                n = sock.send(conn["out"])
                del conn["out"][:n]
            except BlockingIOError:
                pass
            except OSError:
                self.drop(conn)
                return
        if not conn["out"]:
            if conn.get("closing"):
                self.drop(conn)
            elif sock.fileno() != -1:
                self.watch(sock, ("conn", conn))


def daemon_conn(start=True):
    """A connection to the session daemon, starting it if needed (and replacing an idle one of another version)."""
    import socket as sk

    def connect():
        c = sk.socket(sk.AF_UNIX, sk.SOCK_STREAM)
        c.connect(str(SOCK))
        return c

    def start_daemon():
        STATE.mkdir(parents=True, exist_ok=True)
        with open(STATE / "daemon.log", "ab") as log:
            subprocess.Popen([sys.executable, str(pathlib.Path(__file__).resolve()), "daemon"], stdin=subprocess.DEVNULL,
                             stdout=log, stderr=log, start_new_session=True, close_fds=True, cwd=str(HOME))
        for _ in range(60):
            time.sleep(0.05)
            try:
                return connect()
            except OSError:
                pass
        raise SystemExit("moor: session daemon did not start")

    try:
        c = connect()
    except OSError:
        if not start:
            return None
        return start_daemon()
    hello = request_on(c, {"op": "hello"})
    if hello.get("v") != PROTO and not hello.get("sessions"):
        try:
            request_on(connect(), {"op": "quit"})
        except OSError:
            pass
        time.sleep(0.4)
        return start_daemon()
    return connect()


def request_on(c, req):
    c.sendall((json.dumps(req) + "\n").encode())
    buf = b""
    while b"\n" not in buf:
        chunk = c.recv(65536)
        if not chunk:
            break
        buf += chunk
    c.close()
    try:
        return json.loads(buf.split(b"\n", 1)[0] or b"{}")
    except ValueError:
        return {}


def request(req):
    return request_on(daemon_conn(), req)


def cmd_ls():
    r = request({"op": "list"})
    home = str(HOME)
    print(f"NOW\t{r.get('now', int(time.time()))}\t{home}\t{os.path.realpath(home)}")
    for i in r.get("items", []):
        clean = lambda v: str(v).replace("\t", " ").replace("\n", " ")
        preview = "\x1f".join(clean(l) for l in i.get("preview", []))
        print("\t".join(["S", clean(i["name"]), str(i["created"]), str(i["activity"]), str(i["attached"]),
                         clean(i.get("command", "")), clean(i.get("cwd", "")), preview]))


def cmd_simple(req):
    r = request(req)
    if not r.get("ok"):
        print("moor: " + (r.get("error") or "failed"), file=sys.stderr)
        sys.exit(1)


def cmd_attach(name):
    import select
    import signal
    import termios
    import tty
    c = daemon_conn()
    try:
        cols, rows = os.get_terminal_size(0)
    except OSError:
        cols, rows = 80, 24
    c.sendall((json.dumps({"op": "attach", "name": name, "cols": cols, "rows": rows}) + "\n").encode())
    buf = b""
    while b"\n" not in buf:
        chunk = c.recv(65536)
        if not chunk:
            sys.exit("moor: session daemon closed the connection")
        buf += chunk
    line, rest = buf.split(b"\n", 1)
    r = json.loads(line)
    if not r.get("ok"):
        print("moor: " + r.get("error", "attach failed"), file=sys.stderr)
        sys.exit(3)
    frame = lambda kind, data: kind + len(data).to_bytes(4, "big") + data
    wake_r, wake_w = os.pipe()
    signal.signal(signal.SIGWINCH, lambda *_: os.write(wake_w, b"w"))
    saved = termios.tcgetattr(0) if os.isatty(0) else None
    if saved:
        tty.setraw(0)
    try:
        if rest:
            write_all(1, rest)
        while True:
            ready, _, _ = select.select([0, c, wake_r], [], [])
            if wake_r in ready:
                os.read(wake_r, 64)
                try:
                    cols, rows = os.get_terminal_size(0)
                    c.sendall(frame(b"R", json.dumps({"cols": cols, "rows": rows}).encode()))
                except OSError:
                    pass
            if c in ready:
                data = c.recv(65536)
                if not data:
                    break
                write_all(1, data)
            if 0 in ready:
                data = os.read(0, 65536)
                if not data:
                    break
                c.sendall(frame(b"D", data))
    except OSError:
        pass
    finally:
        if saved:
            termios.tcsetattr(0, termios.TCSADRAIN, saved)


def write_all(fd, data):
    view = memoryview(data)
    while view:
        n = os.write(fd, view)
        view = view[n:]


def session_name_from_env():
    sid = os.environ.get("MOOR_SESSION_ID")
    if not sid:
        return ""
    try:
        c = daemon_conn(start=False)
        return request_on(c, {"op": "name", "id": sid}).get("name", "") if c else ""
    except OSError:
        return ""


# ---------------------------------------------------------------- main

def main():
    a = sys.argv[1:]
    if a[:1] == ["claim"]:
        claim(a[1] if len(a) > 1 else "")
    elif a[:1] == ["clean"]:
        rewrite_keys(drop_expired)
    elif a[:1] == ["notify"] and len(a) >= 2:
        notify(a[1], a[2] if len(a) > 2 else "")
    elif a[:1] == ["watch"]:
        since = int(a[2]) if len(a) > 2 and a[1] == "--since" else int(time.time() * 1000)
        try:
            watch(since)
        except (BrokenPipeError, KeyboardInterrupt):
            pass
    elif a[:1] == ["hooks"] and len(a) == 2 and a[1] in ("install", "uninstall", "status"):
        hooks(a[1])
    elif a[:1] == ["daemon"]:
        Daemon().run()
    elif a[:1] == ["ls"]:
        cmd_ls()
    elif a[:1] == ["attach"] and len(a) == 2:
        cmd_attach(a[1])
    elif a[:1] == ["kill"] and len(a) == 2:
        cmd_simple({"op": "kill", "name": a[1]})
    elif a[:1] == ["rename"] and len(a) == 3:
        cmd_simple({"op": "rename", "name": a[1], "to": a[2]})
    elif a[:1] == ["new"]:
        ap = argparse.ArgumentParser(prog="moor new", description="Start a session")
        ap.add_argument("name")
        ap.add_argument("--cmd", default="", help="typed into the session's login shell")
        ap.add_argument("--cwd", default="~")
        ap.add_argument("--cols", type=int, default=80)
        ap.add_argument("--rows", type=int, default=24)
        n = ap.parse_args(a[1:])
        cmd_simple({"op": "new", "name": n.name, "cmd": n.cmd, "cwd": n.cwd, "cols": n.cols, "rows": n.rows})
    elif a[:1] == ["pair"]:
        ap = argparse.ArgumentParser(prog="moor pair", description="Print a one-time pairing QR code for the Moor app")
        ap.add_argument("--host", default=default_host(), help="address the phone uses to reach this machine (default: first IPv4)")
        ap.add_argument("--port", type=int, default=22)
        ap.add_argument("--cmd", default="", help="default command for new sessions on the phone, e.g. claude")
        ap.add_argument("--name", default="", help="name shown in the app (default: this machine's hostname)")
        ap.add_argument("--minutes", type=int, default=10, help="how long the code stays valid (default 10)")
        pair(ap.parse_args(a[1:]))
    else:
        print(__doc__.strip())
        sys.exit(0 if a[:1] in (["-h"], ["--help"], []) else 2)


if __name__ == "__main__":
    main()
