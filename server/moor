HOME = pathlib.Path.home()
# The two variables below exist for tests that run a throwaway sshd.
AK = pathlib.Path(os.environ.get("MOOR_AUTHORIZED_KEYS", HOME / ".ssh" / "authorized_keys"))
# Host key types the app can pin, in order of preference
HOST_KEY_TYPES = ["ssh-ed25519", "ecdsa-sha2-nistp256", "ecdsa-sha2-nistp384", "ecdsa-sha2-nistp521", "ssh-rsa"]
EVENTS = pathlib.Path(os.environ.get("MOOR_EVENTS", HOME / ".local" / "state" / "moor" / "events.log"))
CLAUDE_SETTINGS = HOME / ".claude" / "settings.json"
MARK = "moor-pair:"
PUB_RE = re.compile(r"ssh-ed25519 [A-Za-z0-9+/]{68} ?[A-Za-z0-9@._+-]{0,100}")
EXP_RE = re.compile(r'expiry-time="(\d{12})"')


# ---------------------------------------------------------------- pairing

def rewrite_keys(change):
    """Read-modify-write authorized_keys under a lock, in place (keeps symlinks and mode)."""
    AK.parent.mkdir(mode=0o700, exist_ok=True)
    AK.touch(mode=0o600, exist_ok=True)
    with open(AK, "r+", encoding="utf-8") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        lines = f.read().splitlines()
        new = change(lines)
        if new != lines:
            f.seek(0)
            f.write("".join(line + "\n" for line in new))
            f.truncate()
    return new


def drop_expired(lines):
    now = datetime.datetime.now().strftime("%Y%m%d%H%M")
    out = []
    for line in lines:
        m = EXP_RE.search(line)
        if MARK in line and m and m.group(1) <= now:
            continue
        out.append(line)
    return out


def seed_of(private_key_file):
    """The 32-byte seed inside an unencrypted OpenSSH ed25519 private key."""
    body = "".join(l for l in private_key_file.read_text().splitlines() if not l.startswith("-----"))
    blob = base64.b64decode(body)
    i = blob.index(b"\0") + 1

    def take():
        nonlocal i
        n = int.from_bytes(blob[i:i + 4], "big")
        v = blob[i + 4:i + 4 + n]
        i += 4 + n
        return v

    take(), take(), take()          # cipher, kdf, kdf options
    i += 4                          # number of keys
    take()                          # public key
    priv = take()
    j = 8                           # two check ints
    for _ in range(2):              # key type, public key
        n = int.from_bytes(priv[j:j + 4], "big")
        j += 4 + n
    return priv[j + 4:j + 4 + 32]


def default_host():
    out = subprocess.run(["hostname", "-I"], capture_output=True, text=True).stdout.split()
    v4 = [a for a in out if re.fullmatch(r"\d+\.\d+\.\d+\.\d+", a)]
    return (v4 or out or ["localhost"])[0]


def print_qr(text):
    try:
        import segno
    except ImportError:
        print("(Install segno to show a QR code here: pip3 install --user segno)\n")
        return
    rows = [[bool(c) for c in r] for r in segno.make(text, error="m", micro=False).matrix]
    quiet = 2
    width = len(rows[0]) + quiet * 2
    blank = [False] * width
    rows = [blank] * quiet + [[False] * quiet + r + [False] * quiet for r in rows] + [blank] * quiet
    if len(rows) % 2:
        rows.append(blank)
    # Fixed black on white, so dark terminal themes don't invert the code.
    for top, bottom in zip(rows[0::2], rows[1::2]):
        line = []
        for t, b in zip(top, bottom):
            fg = "\033[38;2;0;0;0m" if t else "\033[38;2;255;255;255m"
            bg = "\033[48;2;0;0;0m" if b else "\033[48;2;255;255;255m"
            line.append(fg + bg + "▀")
        print("".join(line) + "\033[0m")


def add_pair_key(pub, pid, expires):
    """Lets the throwaway key `pub` log in until `expires`, only to run `claim pid`."""
    script = pathlib.Path(__file__).resolve()
    env = f"MOOR_AUTHORIZED_KEYS={AK} " if "MOOR_AUTHORIZED_KEYS" in os.environ else ""
    entry = (f'expiry-time="{expires:%Y%m%d%H%M}",restrict,command="{env}{sys.executable} {script} claim {pid}" '
             f"ssh-ed25519 {pub} {MARK}{pid}")
    rewrite_keys(lambda lines: drop_expired(lines) + [entry])


def invite(pid, minutes):
    """Like pair, for a key made elsewhere: the app sets up another device and sends the throwaway public key."""
    if not re.fullmatch(r"[0-9a-f]{8}", pid) or not 1 <= minutes <= 30:
        sys.exit("bad id or minutes")
    line = sys.stdin.readline(4096).strip()
    if not PUB_RE.fullmatch(line):
        sys.exit("bad key")
    expires = datetime.datetime.now() + datetime.timedelta(minutes=minutes)
    add_pair_key(line.split()[1], pid, expires)
    print(f"ok {int(expires.timestamp())}")


def host_key(ports, required=True):
    """(type, base64) of the host key this machine's sshd presents, asking sshd itself: a key file on disk is
    only used if sshd_config loads it. MOOR_HOST_KEY (a .pub file) overrides, e.g. for a second sshd."""
    override = os.environ.get("MOOR_HOST_KEY")
    if override:
        t, k = pathlib.Path(override).read_text().split()[:2]
        return t, k
    for port in ports:
        try:
            r = subprocess.run(["ssh-keyscan", "-T", "5", "-p", str(port), "localhost"],
                               capture_output=True, text=True, timeout=20)
        except (OSError, subprocess.SubprocessError):
            continue
        keys = {}
        for line in r.stdout.splitlines():
            f = line.split()
            if len(f) >= 3 and not line.startswith("#"):
                keys.setdefault(f[1], f[2])
        for t in HOST_KEY_TYPES:
            if t in keys:
                return t, keys[t]
    if not required:
        return None
    sys.exit("Could not read this machine's SSH host key (ssh-keyscan localhost on port %s). "
             "If sshd listens on another port, pass --sshd-port." % "/".join(map(str, ports)))


# The sshd that `moor-rtc host` connects data channels to (its --ssh default, 127.0.0.1:22)
RTC_SSHD_PORT = 22


def rtc_config():
    """Direct connections (moor-rtc): relay, room and key from ~/.config/moor/rtc.json, or None."""
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    try:
        with open(os.path.join(base, "moor", "rtc.json")) as f:
            c = json.load(f)
        if c.get("signal") and c.get("room") and c.get("key"):
            return c
    except (OSError, ValueError):
        pass
    return None


def pair(args):
    ports = [args.sshd_port] if args.sshd_port else list(dict.fromkeys([args.port, 22]))
    if rtc_config() and not os.environ.get("MOOR_HOST_KEY"):
        # Direct connections reach the sshd that moor-rtc host connects to (port 22 here, its default), so the
        # code pins that one's key. The address in the code is only the fallback for when no direct path opens:
        # if it leads to another sshd, its key differs and the phone would refuse it as a changed host key.
        hk_type, hk = host_key([RTC_SSHD_PORT])
        fallback = host_key(ports, required=False)
        if fallback and fallback != (hk_type, hk):
            print("moor: warning: direct connections reach the sshd on port %d, but the address in this code "
                  "(port %d, used when no direct path opens) leads to an sshd with a different host key; the phone "
                  "would refuse that fallback. Pair with --port %d, or with --sshd-port %d when the phone comes in "
                  "through a forwarded port." % (RTC_SSHD_PORT, ports[0], RTC_SSHD_PORT, RTC_SSHD_PORT), file=sys.stderr)
    else:
        hk_type, hk = host_key(ports)
    pid = secrets.token_hex(4)
    expires = datetime.datetime.now() + datetime.timedelta(minutes=args.minutes)
    with tempfile.TemporaryDirectory() as d:
        key = pathlib.Path(d) / "k"
        subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", MARK + pid, "-f", str(key)], check=True)
        seed = seed_of(key)
        pub = (pathlib.Path(d) / "k.pub").read_text().split()[1]
    add_pair_key(pub, pid, expires)

    q = {
        "v": "1", "h": args.host, "p": str(args.port), "u": getpass.getuser(), "c": args.cmd,
        "n": args.name or socket.gethostname().split(".")[0],
        "hkt": hk_type, "hk": hk, "k": base64.urlsafe_b64encode(seed).decode().rstrip("="),
        "id": pid, "exp": str(int(expires.timestamp())),
    }
    rtc = rtc_config()
    if rtc:
        q.update({"rs": rtc["signal"], "rr": rtc["room"], "rk": rtc["key"]})
    url = "moor://pair?" + urllib.parse.urlencode(q, quote_via=urllib.parse.quote)
    print_qr(url)
    print("\nIn Moor: Settings → Scan QR, or Add machine on the session list. Or copy the link below and use Paste link.")
    print(f"Valid until {expires:%H:%M}, single use.\n")
    print(url)


def claim(pid):
    if not re.fullmatch(r"[0-9a-f]{8}", pid):
        sys.exit("bad id")
    line = sys.stdin.readline(4096).strip()
    if not PUB_RE.fullmatch(line):
        sys.exit("bad key")
    blob = line.split()[1]
    tag = MARK + pid

    def change(lines):
        if not any(l.endswith(tag) for l in lines):
            sys.exit("expired")
        out = [l for l in lines if not l.endswith(tag)]
        if not any(blob in l for l in out):
            out.append(line)
        return drop_expired(out)

    rewrite_keys(change)
    print("ok")


